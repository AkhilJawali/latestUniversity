# Root marker so Lombok stops scanning parent directories.
config.stopBubbling = true

# Propagate Spring's @Qualifier (and @Value) from fields onto the parameters of the
# constructor Lombok generates for @RequiredArgsConstructor / @AllArgsConstructor.
# Without this, @Qualifier on a final field is lost on the generated constructor param,
# causing "required a single bean, but N were found" for ambiguous types
# (e.g. Executor: schedulingEngineExecutor vs Spring Boot's taskScheduler).
lombok.copyableAnnotations += org.springframework.beans.factory.annotation.Qualifier
lombok.copyableAnnotations += org.springframework.beans.factory.annotation.Value
